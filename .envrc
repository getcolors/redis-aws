# -*- mode: sh; sh-shell: bash -*-
export DIRENV_WARN_TIMEOUT=20s
eval "$(devenv direnvrc)"
use devenv 2>/dev/null

# Safe to commit: every credential lives in the gitignored .envrc.private.
# Missing credentials must not prevent credential-free builds or safe dry runs.
# Run `direnv allow` once after the toolchain is installed.
#
# Never export COLORS_PAR_PROFILE. It identifies this deployment and must come
# only from colors.yml.
source_env_if_exists .envrc.private

# The compute provider, the S3 state backend and the package's storage stage
# all read the ambient AWS credential chain. The pair lives only in the
# gitignored .envrc.private as COLORS_PAR_AWS_*; this tracked file maps it
# onto the names the AWS SDKs read. Non-secret plumbing, no values.
export AWS_ACCESS_KEY_ID="${COLORS_PAR_AWS_ACCESS_KEY_ID:-}"
export AWS_SECRET_ACCESS_KEY="${COLORS_PAR_AWS_SECRET_ACCESS_KEY:-}"
export AWS_DEFAULT_REGION="${AWS_DEFAULT_REGION:-us-east-1}"
